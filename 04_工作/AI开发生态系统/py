class PyManager:
    def __init__(self):
        self.items: Dict[str, Any] = {}

    def add(self, key: str, value: Any) -> bool:
        self.items[key] = value
        return True

    def get(self, key: str) -> Optional[Any]:
        return self.items.get(key)

