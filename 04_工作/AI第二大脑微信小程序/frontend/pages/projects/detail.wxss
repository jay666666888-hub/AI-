.container {
  min-height: 100vh;
  background: #f8fafc;
}

.detail-header {
  height: 120rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  color: white;
}

.project-title {
  font-size: 36rpx;
  font-weight: 600;
}

.project-progress {
  font-size: 32rpx;
  font-weight: 500;
}

.info-card {
  background: white;
  margin: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.info-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #999;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.status-active {
  color: #667eea;
}

.progress-section {
  padding: 0 24rpx;
}

.progress-bar-large {
  height: 16rpx;
  background: #e5e7eb;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 8rpx;
  transition: width 0.3s;
}

.tasks-section {
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.add-task-btn {
  font-size: 28rpx;
  color: #667eea;
}

.task-list {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.task-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.task-item:last-child {
  border-bottom: none;
}

.task-item.completed .task-title {
  text-decoration: line-through;
  color: #999;
}

.task-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.task-icon {
  font-size: 32rpx;
}

.task-title {
  font-size: 30rpx;
  color: #333;
}

.circle-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 3rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}

.circle-btn.done {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-color: transparent;
  color: white;
}

.empty-state {
  padding: 48rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}