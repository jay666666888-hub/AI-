/* ==================== 搜索区 ==================== */
.memory-header {
  height: 15vh;
  background: linear-gradient(135deg, #a78bfa 0%, #f472b6 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 0 48rpx;
}

.memory-header .page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 16rpx;
}

.memory-header .search-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 36rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* ==================== 内容区 ==================== */
.memory-content {
  margin-top: -40rpx;
  padding-bottom: 48rpx;
}

/* ==================== 玻璃态卡片 ==================== */
.memory-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

/* ==================== 记忆项 ==================== */
.memory-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.memory-item:last-child {
  border-bottom: none;
}

.memory-item .memory-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  display: block;
}

.memory-item .memory-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.memory-item .tag {
  padding: 4rpx 16rpx;
  background: linear-gradient(135deg, #a78bfa, #f472b6);
  color: white;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.memory-item .memory-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}
