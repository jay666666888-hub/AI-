.container {
  min-height: 100vh;
  background: #f8fafc;
}

.detail-header {
  height: 120rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  color: white;
}

.task-title {
  font-size: 36rpx;
  font-weight: 600;
  flex: 1;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: white;
}

.action-btn.done {
  background: rgba(255, 255, 255, 0.4);
}

.info-card {
  background: white;
  margin: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.info-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #999;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.type-badge {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  color: #666;
}

.type-todo {
  background: #e8f4fd;
  color: #667eea;
}

.type-habit {
  background: #fff3e8;
  color: #ff9500;
}

.type-schedule {
  background: #e8f5e8;
  color: #52c41a;
}

.type-waiting {
  background: #fff7e6;
  color: #faad14;
}

.priority-1, .priority-2 {
  color: #ff4d4f;
}

.priority-3 {
  color: #666;
}

.priority-4, .priority-5 {
  color: #52c41a;
}

.status-active {
  color: #667eea;
}

.status-completed {
  color: #52c41a;
}

.project-name {
  color: #667eea;
}

.detail-section {
  background: white;
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}

.detail-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.action-buttons {
  padding: 24rpx;
  display: flex;
  gap: 16rpx;
}

.action-btn-large {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.complete-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.delete-btn {
  background: #f5f5f5;
  color: #666;
}