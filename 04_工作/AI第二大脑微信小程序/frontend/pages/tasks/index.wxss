/* ==================== 渐变头部 ==================== */
.tasks-header {
  height: 25vh;
  background: linear-gradient(135deg, #a78bfa 0%, #f472b6 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 0 48rpx;
}

.tasks-header .page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 32rpx;
}

/* ==================== 类型切换Tab ==================== */
.type-tabs {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 9999rpx;
}

.type-tabs .tab {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  border-radius: 9999rpx;
}

.type-tabs .tab.active {
  background: white;
  color: #8b5cf6;
  font-weight: 500;
}

/* ==================== 内容区 ==================== */
.tasks-content {
  margin-top: -40rpx;
  padding-bottom: 140rpx;
}

/* ==================== 玻璃态卡片 ==================== */
.task-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

/* ==================== 任务项 ==================== */
.task-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.task-item:last-child {
  border-bottom: none;
}

.task-item.completed .task-title {
  text-decoration: line-through;
  color: #999;
}

.task-item .task-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.task-item .task-icon {
  font-size: 32rpx;
}

.task-item .task-info {
  flex: 1;
}

.task-item .task-title {
  font-size: 28rpx;
  color: #333;
  display: block;
}

.task-item .task-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

/* ==================== 圆形操作按钮 ==================== */
.circle-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  background: rgba(0, 0, 0, 0.06);
  color: #999;
}

.circle-btn.done {
  background: #22c55e;
  color: white;
}

/* ==================== 浮动添加按钮 ==================== */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 32rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #a78bfa, #f472b6);
  color: white;
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 24rpx rgba(167, 139, 250, 0.4);
}

.fab:active {
  transform: scale(0.96);
  opacity: 0.9;
}
