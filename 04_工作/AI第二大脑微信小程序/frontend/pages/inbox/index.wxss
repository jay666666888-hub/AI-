/* ==================== 渐变头部 ==================== */
.inbox-header {
  height: 20vh;
  background: linear-gradient(135deg, #a78bfa 0%, #f472b6 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.inbox-header .page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 8rpx;
}

.inbox-header .inbox-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ==================== 输入区 ==================== */
.input-area {
  margin-top: -40rpx;
  padding: 0 24rpx;
}

.input-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.input-row .note-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.input-row .submit-btn {
  width: 120rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #a78bfa, #f472b6);
  color: white;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

/* ==================== 笔记列表 ==================== */
.notes-list {
  margin-top: 24rpx;
}

.note-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.note-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.note-item:last-child {
  border-bottom: none;
}

.note-item .note-content {
  flex: 1;
}

.note-item .note-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  display: block;
}

.note-item .note-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.note-item .delete-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ef4444;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-left: 16rpx;
}
