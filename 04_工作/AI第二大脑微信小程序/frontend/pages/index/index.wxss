/* ==================== 渐变头部 ==================== */
.index-header {
  height: 35vh;
  background: linear-gradient(135deg, #a78bfa 0%, #f472b6 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.index-header .date-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  margin-bottom: 48rpx;
}

.index-header .stats-row {
  display: flex;
  justify-content: space-around;
}

.index-header .stat-item {
  text-align: center;
  flex: 1;
}

.index-header .stat-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.index-header .stat-num {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: white;
  line-height: 1.2;
}

.index-header .stat-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

/* ==================== 内容区 ==================== */
.index-content {
  margin-top: -40rpx;
  padding-bottom: 48rpx;
}

/* ==================== 玻璃态卡片 ==================== */
.index-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

/* ==================== 列表项 ==================== */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item .item-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.list-item .item-icon {
  font-size: 32rpx;
}

.list-item .item-info {
  flex: 1;
}

.list-item .item-title {
  font-size: 28rpx;
  color: #333;
  display: block;
}

.list-item .item-subtitle {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.list-item .item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* ==================== 状态圆点 ==================== */
.status-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.status-dot.done {
  background: #22c55e;
  color: white;
}

.status-dot.pending {
  background: rgba(0, 0, 0, 0.08);
  color: #999;
}

/* ==================== 箭头 ==================== */
.arrow-right {
  font-size: 28rpx;
  color: #8b5cf6;
}

/* ==================== 进度条 ==================== */
.progress-text {
  font-size: 22rpx;
  color: #8b5cf6;
  font-weight: 500;
}
