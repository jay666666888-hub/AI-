/* ==================== 渐变头部 ==================== */
.habits-header {
  height: 35vh;
  background: linear-gradient(135deg, #a78bfa 0%, #f472b6 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.habits-header .date-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 32rpx;
}

.habits-header .stats-row {
  display: flex;
  justify-content: space-around;
  width: 100%;
}

.habits-header .stat-item {
  text-align: center;
  flex: 1;
}

.habits-header .stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: white;
}

.habits-header .stat-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

/* ==================== 内容区 ==================== */
.habits-content {
  margin-top: -40rpx;
  padding-bottom: 48rpx;
}

/* ==================== 玻璃态卡片 ==================== */
.habit-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

/* ==================== 习惯项 ==================== */
.habit-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.habit-item:last-child {
  border-bottom: none;
}

.habit-item .habit-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.habit-item .habit-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.habit-item .habit-icon {
  font-size: 32rpx;
}

.habit-item .habit-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.habit-item .habit-time {
  font-size: 22rpx;
  color: #999;
}

/* ==================== 打卡按钮 ==================== */
.checkin-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #a78bfa, #f472b6);
  color: white;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.checkin-btn.completed {
  background: #22c55e;
}

.checkin-btn:active {
  transform: scale(0.96);
}

/* ==================== 图表区域 ==================== */
.chart-section {
  padding: 0 32rpx 32rpx;
}

.chart-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
}

.chart-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 24rpx;
  display: block;
}

.week-chart {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.week-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.day-label {
  font-size: 24rpx;
  color: #6b7280;
}

.day-indicator {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #d1d5db;
}

.dot.filled {
  background: #10b981;
}

.week-day.today .day-indicator {
  border: 2rpx solid #3b82f6;
}

.week-day.done .day-indicator {
  background: rgba(16, 185, 129, 0.1);
}

.week-day.done .dot {
  background: #10b981;
}

.chart-legend {
  display: flex;
  gap: 32rpx;
  justify-content: center;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.done {
  background: #10b981;
}

.legend-dot.pending {
  background: #d1d5db;
}

/* ==================== 连续打卡卡片 ==================== */
.streak-card {
  background: linear-gradient(135deg, #f97316 0%, #ef4444 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: white;
}

.streak-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.streak-icon {
  font-size: 48rpx;
}

.streak-text {
  display: flex;
  flex-direction: column;
}

.streak-num {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.streak-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.streak-progress {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.progress-bar {
  width: 160rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: white;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 20rpx;
  opacity: 0.8;
}

/* ==================== 习惯项样式更新 ==================== */
.habit-item {
  padding: 24rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s ease;
}

.habit-item.completed {
  background: rgba(16, 185, 129, 0.1);
}

.habit-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.habit-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.habit-icon {
  font-size: 32rpx;
}

.habit-detail {
  display: flex;
  flex-direction: column;
}

.habit-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
}

.habit-meta {
  font-size: 22rpx;
  color: #6b7280;
}

.habit-status {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.habit-status.done {
  background: rgba(16, 185, 129, 0.2);
  color: #059669;
}

.habit-status.pending {
  background: rgba(239, 68, 68, 0.1);
  color: #dc2626;
}

.habit-actions {
  display: flex;
  justify-content: flex-end;
}

.checkin-btn {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
  color: white;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.checkin-btn.completed {
  background: #10b981;
}

.checkin-btn:active {
  transform: scale(0.95);
}
