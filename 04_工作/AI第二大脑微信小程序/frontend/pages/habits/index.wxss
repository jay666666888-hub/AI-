/* ==================== 渐变头部 ==================== */
.habits-header {
  height: 35vh;
  background: linear-gradient(135deg, #a78bfa 0%, #f472b6 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.habits-header .date-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 32rpx;
}

.habits-header .stats-row {
  display: flex;
  justify-content: space-around;
  width: 100%;
}

.habits-header .stat-item {
  text-align: center;
  flex: 1;
}

.habits-header .stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: white;
}

.habits-header .stat-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

/* ==================== 内容区 ==================== */
.habits-content {
  margin-top: -40rpx;
  padding-bottom: 48rpx;
}

/* ==================== 玻璃态卡片 ==================== */
.habit-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

/* ==================== 习惯项 ==================== */
.habit-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.habit-item:last-child {
  border-bottom: none;
}

.habit-item .habit-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.habit-item .habit-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.habit-item .habit-icon {
  font-size: 32rpx;
}

.habit-item .habit-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.habit-item .habit-time {
  font-size: 22rpx;
  color: #999;
}

/* ==================== 打卡按钮 ==================== */
.checkin-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #a78bfa, #f472b6);
  color: white;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.checkin-btn.completed {
  background: #22c55e;
}

.checkin-btn:active {
  transform: scale(0.96);
}
