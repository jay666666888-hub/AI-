<view class="container">
  <!-- 渐变头部 -->
  <view class="habits-header">
    <text class="date-text">📅 {{stats.date}}</text>
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-num">{{stats.completed || 0}}</text>
        <text class="stat-label">今日完成</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.pending || 0}}</text>
        <text class="stat-label">待打卡</text>
      </view>
      <view class="stat-item highlight">
        <text class="stat-num">{{stats.total || 0}}</text>
        <text class="stat-label">总习惯数</text>
      </view>
    </view>
  </view>

  <!-- 本周进度图表 -->
  <view class="chart-section">
    <view class="chart-card">
      <text class="chart-title">📊 本周进度</text>
      <view class="week-chart">
        <view class="week-day {{item.completed ? 'done' : ''}} {{item.today ? 'today' : ''}}" wx:for="{{weekDays}}" wx:key="day">
          <text class="day-label">{{item.day}}</text>
          <view class="day-indicator">
            <view class="dot {{item.completed ? 'filled' : ''}}"></view>
          </view>
        </view>
      </view>
      <view class="chart-legend">
        <view class="legend-item">
          <view class="legend-dot done"></view>
          <text>已完成</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot pending"></view>
          <text>未完成</text>
        </view>
      </view>
    </view>

    <!-- 连续打卡统计 -->
    <view class="streak-card">
      <view class="streak-info">
        <text class="streak-icon">🔥</text>
        <view class="streak-text">
          <text class="streak-num">{{stats.streak || 0}}</text>
          <text class="streak-label">连续打卡天数</text>
        </view>
      </view>
      <view class="streak-progress">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{stats.streak / 30 * 100}}%"></view>
        </view>
        <text class="progress-text">目标 30 天</text>
      </view>
    </view>
  </view>

  <!-- 习惯列表 -->
  <view class="habits-content">
    <view class="habit-card">
      <view class="section-header">
        <text class="section-title">🔥 今日习惯</text>
      </view>
      <view class="habit-list">
        <view class="habit-item {{item.is_completed_today ? 'completed' : ''}}" wx:for="{{habits}}" wx:key="id">
          <view class="habit-top">
            <view class="habit-info">
              <text class="habit-icon">{{item.is_completed_today ? '✅' : '☀️'}}</text>
              <view class="habit-detail">
                <text class="habit-title">{{item.title}}</text>
                <text class="habit-meta">{{item.frequency}} · {{item.execution_mode}}</text>
              </view>
            </view>
            <view class="habit-status {{item.is_completed_today ? 'done' : 'pending'}}">
              {{item.is_completed_today ? '已打卡' : '待打卡'}}
            </view>
          </view>
          <view class="habit-actions">
            <view class="checkin-btn {{item.is_completed_today ? 'completed' : ''}}" bindtap="logHabit" data-id="{{item.id}}">
              {{item.is_completed_today ? '✓ 已完成' : '立即打卡'}}
            </view>
          </view>
        </view>
        <view class="empty-state" wx:if="{{!habits.length}}">暂无习惯，点击右下角+添加</view>
      </view>
    </view>
  </view>

  <!-- 浮动按钮 -->
  <view class="fab" bindtap="goToCreate">+</view>
</view>